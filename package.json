{
	"name": "dukto",
	"private": true,
	"version": "0.2.3",
	"type": "module",
	"scripts": {
		"android:init": "bunx tauri android init --ci && node scripts/configure-android.mjs",
		"android:prepare": "node scripts/configure-android.mjs",
		"android:build": "node scripts/configure-android.mjs --require-signing && bunx tauri android build --aab",
		"site:dev": "vite --config site/vite.config.ts",
		"site:build": "node scripts/build-site.mjs",
		"site:check": "tsc -p site/tsconfig.json --noEmit",
		"site:preview": "vite preview --config site/vite.config.ts --host 127.0.0.1 --port 4179",
		"release:collect": "node scripts/collect-release.mjs",
		"cli": "cargo run --manifest-path src-tauri/Cargo.toml --no-default-features --features cli --bin dukto-cli --",
		"cli:build": "cargo build --manifest-path src-tauri/Cargo.toml --no-default-features --features cli --bin dukto-cli --release",
		"dev": "bunx @tauri-apps/cli dev",
		"build": "bunx @tauri-apps/cli build",
		"lint": "biome check . && tsc --noEmit",
		"lint:fix": "biome check --write .",
		"test": "bun test",
		"vite:dev": "vite",
		"vite:build": "vite build"
	},
	"dependencies": {
		"@kobalte/core": "^0.13.11",
		"@tanstack/solid-router": "^1.167.5",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-deep-link": "^2.0.0",
		"@tauri-apps/plugin-dialog": "^2.7.3",
		"@tauri-apps/plugin-notification": "^2",
		"@tauri-apps/plugin-os": "^2",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-shell": "^2",
		"@tauri-apps/plugin-updater": "^2.11.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"i18next": "^25.8.20",
		"i18next-browser-languagedetector": "^8.2.1",
		"i18next-resources-to-backend": "^1.2.1",
		"solid-js": "^1.9",
		"tailwind-merge": "^3.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9",
		"@iconify/json": "^2.2.452",
		"@tailwindcss/vite": "^4",
		"@tanstack/intent": "^0.0.23",
		"@tanstack/router-plugin": "^1.166.14",
		"@tauri-apps/cli": "^2",
		"@types/node": "^25.5.0",
		"tailwindcss": "^4",
		"typescript": "^5.7",
		"unplugin-icons": "^23.0.1",
		"vite": "^6",
		"vite-plugin-solid": "^2"
	}
}
