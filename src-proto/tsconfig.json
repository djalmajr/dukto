{
	"compilerOptions": {
		"strict": true,
		"target": "ES2021",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"skipLibCheck": true,
		"paths": {
			"~/*": ["../src/*"]
		}
	},
	"exclude": ["../**/*.test.ts", "../**/*.test.tsx", "src/**/*.test.ts", "../src/routeTree.gen.ts", "../src/routes/**", "../src/index.tsx"],
	"include": ["src", "../src"]
}
