{
	"$schema": "https://raw.githubusercontent.com/nicokosi/tauri-v2-schemas/main/capabilities.schema.json",
	"identifier": "default",
	"description": "Default capabilities for Dukto",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"core:window:allow-start-dragging",
		"core:window:allow-minimize",
		"core:window:allow-close",
		"dialog:default",
		"notification:default",
		"os:default",
		"shell:default"
	]
}
