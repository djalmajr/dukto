{
	"$schema": "https://raw.githubusercontent.com/nicokosi/tauri-v2-schemas/main/tauri.conf.json",
	"productName": "Dukto",
	"version": "0.1.0",
	"identifier": "com.dukto.app",
	"build": {
		"beforeDevCommand": "bun run vite:dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run vite:build",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"title": "Dukto",
				"width": 480,
				"height": 640,
				"resizable": true,
				"fullscreen": false,
				"center": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
