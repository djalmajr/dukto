{
	"$schema": "https://raw.githubusercontent.com/nicokosi/tauri-v2-schemas/main/tauri.conf.json",
	"productName": "Dukto",
	"version": "0.1.1",
	"identifier": "com.dukto.app",
	"build": {
		"features": ["desktop"],
		"beforeDevCommand": "bun run vite:dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run vite:build",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"title": "Dukto",
				"width": 600,
				"minWidth": 480,
				"maxWidth": 640,
				"height": 600,
				"minHeight": 360,
				"resizable": true,
				"maximizable": false,
				"fullscreen": false,
				"center": true,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"createUpdaterArtifacts": true
	},
	"plugins": {
		"updater": {
			"endpoints": ["https://github.com/djalmajr/dukto/releases/latest/download/latest.json"],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2RUQ3OUMwM0M4NDBGMDUKUldRRkQ0UTh3SG50NWdVWGMySVRXQWdoOVJmK3JRRkUwS2g1cjJJMzVtbzRRKytwTlFGTEkxTGcK",
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
